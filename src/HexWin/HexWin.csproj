<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe : pas de fenêtre console au lancement. L'application vit dans
         la barre système. Le mode CLI de transcription se rattache à la
         console parente quand il y en a une (voir Program.cs). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>HexWin</AssemblyName>
    <RootNamespace>HexWin</RootNamespace>

    <ApplicationIcon></ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Exigé par LibraryImport, le générateur d'interop moderne. HexWin
         appelle Win32 de bout en bout : console, hook clavier, SendInput.
         Le projet de tests, lui, reste sans code unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- PreserveNewest et non Always : une configuration modifiée par
         l'utilisateur à côté de l'exécutable ne doit pas être écrasée à
         chaque compilation. -->
    <None Update="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.0.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.5" />
  </ItemGroup>

</Project>
