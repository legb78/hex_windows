<Project>

  <!-- Version du produit. C'est la SEULE source de vérité : la fusion vers
       main publie automatiquement la version inscrite ici, et ne fait rien si
       l'étiquette correspondante existe déjà. Publier revient donc à monter ce
       numéro dans une PR. -->
  <PropertyGroup>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <!-- Réglages communs à tous les projets de la solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Le moindre avertissement fait échouer la compilation : c'est ce qui
         garde le code propre sans avoir à y penser, en local comme en CI. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
