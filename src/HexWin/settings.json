{
  // HexWin settings. Comments are allowed.
  // An invalid value is silently replaced by its default: a damaged file
  // never stops dictation from starting.

  // Folder holding the Parakeet model, relative to the executable.
  // A folder and not a file: the model is made of an encoder, a decoder,
  // a joiner and a vocabulary.
  // Download it with get-model.ps1
  "modelPath": "models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8",

  // There is no language setting: Parakeet v3 works out on its own which of
  // its 25 European languages is being spoken.

  // Keys to hold in order to dictate.
  // Accepted values: Ctrl, LeftCtrl, RightCtrl, Alt, LeftAlt, RightAlt,
  // Shift, LeftShift, RightShift, Win, LeftWin, RightWin, CapsLock, Space,
  // F13 through F24.
  // Fn cannot be used: it is handled by the keyboard controller and emits no
  // code Windows can see.
  "hotkey": ["Ctrl", "Win"],

  // Below this, the keypress is treated as accidental and ignored.
  "minRecordingMilliseconds": 250,

  // Stops recording if the key stays held down.
  "maxRecordingSeconds": 120,

  // Minutes without dictating after which the model is freed from memory.
  // Set 0 to keep it resident indefinitely.
  //
  // The model takes about 1 GB once loaded. Freeing it returns that memory to
  // the system; the next dictation pays a reload of roughly 2 s — but the
  // reload starts the moment the hotkey is PRESSED, so it runs while you are
  // still speaking. On a two-second phrase you feel nothing.
  "unloadAfterMinutes": 5,

  // Compute provider. "cpu" is the only one available today, and that is not
  // a choice: the sherpa-onnx native libraries published on NuGet are built
  // for CPU only.
  //
  // "directml" and "cuda" were removed after testing: they were accepted,
  // then silently fell back to the CPU. The setting promised an acceleration
  // that could not happen. Using a GPU would mean rebuilding sherpa-onnx —
  // for an uncertain gain, since the CPU already transcribes a five-second
  // phrase in 0.17 s.
  "provider": "cpu",

  // Threads allocated to decoding. Past a handful the gain collapses: the
  // model is small and synchronisation costs more than parallelism returns.
  "threads": 4,

  // "Paste" : clipboard then Ctrl+V (instant).
  // "Type"  : simulated keystrokes, for applications that ignore pasting.
  "insertion": "Paste",

  // What tells you that the recording started and stopped. The tray icon
  // turns red already, but nobody watches the tray while dictating.
  //
  // "None"   : nothing beyond the tray icon.
  // "Visual" : a circle at the top of the screen while the application is
  //            busy, in the colour of the tray icon: red while recording,
  //            orange while transcribing, nothing at rest. Click-through,
  //            and it never takes the focus.
  // "Sound"  : a short tone on start, a lower one on stop.
  // "Both"   : the two together.
  //
  // On speakers rather than headphones, the start tone is picked up by the
  // microphone that has just opened. Measured against the same recording
  // with and without it: the transcription is identical, the engine emits
  // nothing for a pure tone. The level measurement skips the opening of the
  // recording as well, so a muted microphone still reads as silent.
  "feedback": "Both",

  // Appearance of the circle. Ignored when "feedback" leaves it out.
  //
  // feedbackColor     : "auto" follows the tray icon — red while recording,
  //                     orange while transcribing. A #RRGGBB value forces one
  //                     colour whatever the state; the hash and the case are
  //                     optional, and anything unreadable falls back to auto.
  // feedbackSize      : diameter in pixels, 16 to 512. Around 40 gives a
  //                     discreet dot, 96 a circle hard to miss.
  // feedbackOpacity   : 20 to 255. Never zero: a circle asked for and then
  //                     rendered invisible reads as a broken feature.
  // feedbackTopMargin : pixels between the circle and the top of the usable
  //                     area, taskbar excluded.
  "feedbackColor": "auto",
  "feedbackSize": 64,
  "feedbackOpacity": 235,
  "feedbackTopMargin": 40,

  // Logs each dictation: duration, captured level, characters produced.
  // Those three numbers together tell you whether the microphone heard you,
  // whether the engine understood you, and whether the text made it out.
  "logEnabled": true
}
